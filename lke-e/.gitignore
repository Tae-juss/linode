# ── Terraform state & credentials ────────────────────────────────────────────
# Never commit actual tfvars — they contain API tokens.
# Only *.tfvars.example files should be tracked.
terraform.tfvars
*.tfvars.backup

# Terraform working directories
.terraform/
.terraform.lock.hcl

# State files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Cluster credentials ───────────────────────────────────────────────────────
# Written by the cluster module after provisioning
.kubeconfig
*.kubeconfig

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
.idea/
*.iml
.vscode/
